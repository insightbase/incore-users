{templateType App\UI\Admin\BaseTemplate}

{layout $layoutFile}

{block h1}{_'header_users'}{/block}

{block content}

    {control grid}

    {embed basicModal, 'form-new'}
        {block title}{_'header_newUser'}{/block}
        {block body}
            {snippet 'formNew'}
                {embed basicForm, formNew}{/embed}
            {/snippet}
        {/block}
    {/embed}
{/block}